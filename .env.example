# Credenciales de Azure Blob Storage.
# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a git.
#
# Opcion A (la mas simple): connection string completa
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# Opcion B: cuenta + account key
# AZURE_STORAGE_ACCOUNT="<cuenta>"
# AZURE_STORAGE_KEY="<key>"

# Opcion C: cuenta + SAS token (recomendado, permisos acotados y con vencimiento)
# AZURE_STORAGE_ACCOUNT="<cuenta>"
# AZURE_STORAGE_SAS_TOKEN="?sv=..."
